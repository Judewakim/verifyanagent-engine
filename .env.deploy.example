# Copy this file to .env.deploy (gitignored) and fill in the real values.
# Used by trigger.ps1 and rebuild-all.ps1 for local webhook synthesis.

# API Gateway endpoint that fronts the Lambda — find it in the AWS console
# under API Gateway -> verifyanagent API -> Stages -> prod -> Invoke URL.
API_GATEWAY_URL=https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod

# Stripe webhook signing secret — the same value set in Lambda's env vars.
# Find it in Stripe Dashboard -> Developers -> Webhooks -> click your endpoint
# -> "Signing secret" -> Reveal.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Airtable personal access token — same value set in Lambda's env vars.
# Find it at https://airtable.com/create/tokens (needs data.records:read scope
# on the Agents base for rebuild-all.ps1).
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Airtable base ID — same value set in Lambda's env vars.
# Find it in the Airtable API docs for your base (starts with 'app').
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
