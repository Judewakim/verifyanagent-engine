<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>License Verification — {{ agent_name }} | {{ agency_name }}</title>

  <!-- FAVICON -->
  <link rel="icon" href="{{ logo_icon }}" />

  <link rel="stylesheet" href="style.css" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

  <!-- Calendly -->
  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>

  <style>
    /* =============================================
       VERIFY PAGE — Page-specific styles
       ============================================= */

    /* Brand color override. Unlike style.css (served verbatim), this template
       IS rendered through Jinja, so the agent's primary_color is substituted
       here. When set, accents use it and buttons fill with it on hover. When
       unset, the block is omitted and everything falls back to the static
       defaults in style.css (navy --blue, monochrome black/white button hover). */
{% if primary_color %}
    :root {
      --blue: {{ primary_color }};
      --btn-hover-bg: {{ primary_color }};
      --btn-hover-text: {{ brand_text_color }};
      --btn-hover-border: {{ primary_color }};
    }
{% endif %}

    /* HERO */
    .verify-hero {
      padding: 12rem 0 5rem;
      background: var(--white);
      border-bottom: 1px solid var(--border);
      text-align: center;
    }

    .verify-hero .eyebrow {
      margin-bottom: 2.5rem;
    }

    .agent-profile {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.2rem;
      max-width: 680px;
      margin: 0 auto;
    }

    /* Replace jude-wakim.jpg with your photo — circular crop, 140×140 */
    .agent-photo {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      object-fit: cover;
      object-position: center top;
      border: 3px solid var(--border);
      display: block;
      background: var(--surface);
    }

    .verify-name {
      font-family: var(--font-serif);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 400;
      color: var(--ink);
      margin: 0;
      line-height: 1.1;
    }

    .agent-badge {
      display: inline-block;
      font-size: 0.65rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink);
    }

    .calendly-btn {
      display: inline-block;
      font-size: 0.65rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
      border: 1px solid var(--ink);
      padding: 0.22rem 0.75rem;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s var(--ease), color 0.2s var(--ease);
    }

    /* Hover fills with the agent's brand color (white text) when set;
       falls back to the monochrome black-outline-on-white treatment when not. */
    .calendly-btn:hover {
      background: var(--btn-hover-bg, var(--white));
      color: var(--btn-hover-text, var(--ink));
      border-color: var(--btn-hover-border, var(--ink));
    }

    /* Tiny "Check on NIPR" pill sitting beside the NPN in the badge. */
    .nipr-btn {
      display: inline-block;
      margin-left: 0.5rem;
      vertical-align: middle;
      font-size: 0.55rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--blue);
      border: 1px solid var(--blue);
      border-radius: 2px;
      padding: 0.1rem 0.4rem;
      text-decoration: none;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
    }

    /* Same brand-color hover behavior as the Schedule-a-Call button. */
    .nipr-btn:hover {
      background: var(--btn-hover-bg, var(--white));
      color: var(--btn-hover-text, var(--ink));
      border-color: var(--btn-hover-border, var(--ink));
    }

    .agent-contact {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-muted);
      flex-wrap: wrap;
      justify-content: center;
    }

    /* Email link — black at rest, brand color on hover (accent as an
       interaction cue, like the buttons). */
    .agent-email {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid currentColor;
      padding-bottom: 1px;
      transition: color 0.2s var(--ease);
    }

    .agent-email:hover {
      color: var(--blue);
    }

    .contact-sep {
      color: var(--border);
    }

    .agent-npn {
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-muted);
      margin-top: -0.7rem;
    }

    .verify-tagline {
      font-size: 0.95rem;
      color: var(--ink-mid);
      line-height: 1.8;
      max-width: 680px;
      margin: 0.4rem 0 0;
    }

    /* LICENSES SECTION */
    .licenses {
      background: var(--off);
    }

    .licenses .section-label {
      margin-bottom: 2rem;
    }

    .license-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    @media (max-width: 960px) {
      .license-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .license-card {
      background: var(--white);
      border: 1px solid var(--border);
      padding: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .license-card-header {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    /* State seal badge — swap for an <img> tag if you have a logo file */
    .state-seal {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-serif);
      font-size: 1.1rem;
      font-weight: 400;
      flex-shrink: 0;
      letter-spacing: 0.01em;
    }

    .fl-seal {
      background: var(--blue);
      color: var(--white);
    }

    .state-name {
      font-family: var(--font-serif);
      font-size: 1.3rem;
      font-weight: 400;
      color: var(--ink);
      margin: 0 0 0.2rem;
      line-height: 1.2;
    }

    .state-dept {
      font-size: 0.65rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    .license-details {
      display: flex;
      flex-direction: column;
      border-top: 1px solid var(--border);
    }

    .license-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border);
      gap: 1rem;
    }

    .lic-label {
      font-size: 0.65rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-muted);
      flex-shrink: 0;
    }

    .lic-value {
      font-size: 0.88rem;
      color: var(--ink);
      font-weight: 400;
      text-align: right;
    }

    .lic-active {
      color: #1a6b3a;
      font-weight: 500;
    }

    .lic-pending {
      color: #b08a00;
      font-weight: 500;
    }

    .verify-btn {
      width: 100%;
      text-align: center;
      padding: 0.9rem 1.5rem;
      font-size: 0.78rem;
      /* Border matches the dark fill at rest (invisible); becomes the black
         outline on hover with no layout shift. */
      border: 1px solid var(--ink);
    }

    /* Hover fills with the agent's brand color (white text) when set;
       falls back to the monochrome black-outline-on-white treatment when not. */
    .verify-btn:hover {
      background: var(--btn-hover-bg, var(--white));
      color: var(--btn-hover-text, var(--ink));
      border-color: var(--btn-hover-border, var(--ink));
      transform: none;
    }

    /* CARRIERS IMAGE */
    .carriers-wrap {
      width: 100%;
      max-width: 680px;
      margin-top: 1.5rem;
    }

    .carriers-label {
      font-size: 0.62rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-muted);
      margin-bottom: 0.75rem;
      display: block;
    }

    .carriers-img {
      width: 100%;
      border: 1px solid var(--border);
      display: block;
      cursor: zoom-in;
      transition: opacity 0.2s;
    }

    .carriers-img:hover { opacity: 0.9; }

    /* CARD BUTTON ROW */
    .card-btn-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    /* When certificates are hidden, only the Verify button remains — center it
       at its natural width instead of stretching across a single grid column. */
    .card-btn-row.verify-only {
      display: flex;
      justify-content: center;
    }

    .btn-outline {
      display: inline-block;
      background: var(--white);
      color: var(--ink);
      font-family: var(--font-sans);
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-align: center;
      padding: 0.9rem 1.5rem;
      border: 1px solid var(--ink);
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s var(--ease), color 0.2s var(--ease);
    }

    /* Hover fills with the agent's brand color (white text) when set;
       falls back to the monochrome black fill when not. */
    .btn-outline:hover {
      background: var(--btn-hover-bg, var(--ink));
      color: var(--btn-hover-text, var(--white));
      border-color: var(--btn-hover-border, var(--ink));
    }

    /* LIGHTBOX */
    .lightbox-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.92);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .lightbox-overlay.open { display: flex; }

    .lightbox-overlay img {
      max-width: 92vw;
      max-height: 88vh;
      object-fit: contain;
      cursor: default;
      display: block;
    }

    .lightbox-close {
      position: absolute;
      top: 1rem;
      right: 1.5rem;
      color: rgba(255,255,255,0.75);
      font-size: 2.2rem;
      line-height: 1;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0.4rem 0.6rem;
      font-family: var(--font-sans);
      font-weight: 300;
      transition: color 0.2s;
    }

    .lightbox-close:hover { color: #fff; }

    /* SITE HEADER — nav + trust strip pinned together.
       .nav is position:fixed in style.css; inside this combined fixed header
       it flows normally so the trust strip always sits flush beneath it, with
       no gap when the nav shrinks (.scrolled) on scroll. */
    .site-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
    }
    .site-header .nav { position: static; }

    /* VERIFICATION TRUST STRIP */
    .trust-strip {
      --verify-green: #00824d;
      background: var(--off);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .trust-strip-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: nowrap;
      gap: 0.4rem 1.5rem;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }

    /* Items wrap to a second line within their own column while the seal
       stays pinned to the right edge of the strip. */
    .trust-items {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem 1.4rem;
      flex: 1 1 auto;
    }

    .trust-seal { flex: 0 0 auto; }

    .trust-item {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.64rem;
      font-weight: 500;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: var(--ink-mid);
      white-space: nowrap;
    }

    .trust-item .check {
      color: var(--verify-green);
      font-weight: 700;
      font-size: 0.8rem;
      line-height: 1;
    }

    .trust-seal {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: none;
      border: none;
      padding: 0.2rem 0;
      cursor: pointer;
      color: var(--blue);
      font-family: var(--font-sans);
      font-size: 0.64rem;
      font-weight: 500;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      transition: opacity 0.2s var(--ease);
    }

    .trust-seal:hover { opacity: 0.6; }
    .trust-seal .seal-icon { width: 22px; height: 22px; flex-shrink: 0; }
    .trust-seal .seal-text { white-space: nowrap; }
    .trust-seal .seal-cta { color: var(--ink-muted); white-space: nowrap; }

    @media (max-width: 720px) {
      /* Stack to a single-column checklist with the seal beneath it. */
      .trust-strip-inner { flex-wrap: wrap; }
      .trust-items {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.32rem;
        flex-basis: 100%;
      }
      .trust-item { font-size: 0.6rem; letter-spacing: 0.08em; }
      .trust-seal { font-size: 0.6rem; letter-spacing: 0.08em; margin-top: 0.2rem; }
    }

    /* VERIFICATION INFO MODAL — mirrors the lightbox overlay pattern */
    .info-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(17,17,17,0.55);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      cursor: pointer;
    }

    .info-overlay.open { display: flex; }

    .info-modal {
      background: var(--white);
      cursor: default;
      max-width: 560px;
      width: 100%;
      max-height: 86vh;
      overflow-y: auto;
      padding: 2.5rem 2.5rem 2rem;
      border-top: 4px solid var(--blue);
      position: relative;
      box-shadow: 0 24px 60px rgba(0,0,0,0.25);
    }

    .info-modal h2 {
      font-family: var(--font-serif);
      font-weight: 400;
      font-size: 1.6rem;
      color: var(--ink);
      margin-bottom: 1.4rem;
      padding-right: 1.5rem;
    }

    .info-block { margin-bottom: 1.1rem; }
    .info-block:last-child { margin-bottom: 0; }

    .info-block strong {
      display: block;
      font-size: 0.66rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: 0.3rem;
    }

    .info-block p {
      font-size: 0.92rem;
      font-weight: 300;
      line-height: 1.6;
      color: var(--ink-mid);
    }

    .info-close {
      position: absolute;
      top: 0.8rem;
      right: 1rem;
      background: none;
      border: none;
      font-size: 1.8rem;
      line-height: 1;
      color: var(--ink-muted);
      cursor: pointer;
      font-family: var(--font-sans);
      font-weight: 300;
      transition: color 0.2s;
    }

    .info-close:hover { color: var(--ink); }

    /* TESTIMONIALS CAROUSEL */
    .testimonials {
      background: var(--white);
      border-top: 1px solid var(--border);
      padding: 3rem 0;
      overflow: hidden;
    }

    .testimonials .section-label {
      margin-bottom: 1rem;
      text-align: center;
    }

    .testimonials-track-wrap {
      overflow: hidden;
      position: relative;
      width: 100%;
      max-width: 100%;
    }

    .testimonials-track {
      display: flex;
      transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: transform;
    }

    .testimonial-card {
      flex-shrink: 0;
      padding: 0 1rem;
      box-sizing: border-box;
    }

    .testimonial-inner {
      background: var(--white);
      border: 1px solid var(--border);
      padding: 2.5rem 2.8rem;
      max-width: 680px;
      margin: 0 auto;
      position: relative;
    }

    .testimonial-inner::before {
      content: '\201C';
      font-family: var(--font-serif);
      font-size: 5rem;
      line-height: 1;
      color: var(--blue);
      opacity: 0.18;
      position: absolute;
      top: 0.6rem;
      left: 1.6rem;
    }

    .testimonial-quote {
      font-size: 1.05rem;
      line-height: 1.8;
      color: var(--ink-mid);
      margin: 0 0 1.5rem;
      font-style: italic;
    }

    .testimonial-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .testimonial-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--blue);
      color: var(--white);
      font-family: var(--font-serif);
      font-size: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .testimonial-name {
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--ink);
      margin: 0;
    }

    .testimonial-location {
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    .testimonials-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.2rem;
      margin-top: 1.2rem;
    }

    .t-arrow {
      width: 36px;
      height: 36px;
      border: 1px solid var(--border);
      background: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
      flex-shrink: 0;
    }

    .t-arrow:hover {
      background: var(--ink);
      border-color: var(--ink);
    }

    .t-arrow:hover svg path {
      stroke: var(--white);
    }

    .t-arrow svg {
      width: 14px;
      height: 14px;
    }

    .t-arrow svg path {
      stroke: var(--ink);
      stroke-width: 1.8;
      fill: none;
      transition: stroke 0.2s;
    }

    .t-dots {
      display: flex;
      gap: 0.5rem;
    }

    .t-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--border);
      cursor: pointer;
      transition: background 0.2s;
    }

    .t-dot.active {
      background: var(--blue);
    }

    /* Responsive — tablet */
    @media (max-width: 680px) {
      .agent-profile {
        max-width: 100%;
        padding: 0 0.5rem;
      }

      .verify-tagline {
        max-width: 100%;
      }

      .carriers-wrap {
        max-width: 100%;
      }
    }

    /* Responsive — mobile */
    @media (max-width: 580px) {
      .verify-hero {
        padding: 8rem 0 4rem;
      }

      .license-grid {
        grid-template-columns: 1fr;
      }

      /* Stack the two hero buttons vertically */
      .agent-contact {
        flex-direction: column;
        gap: 0.5rem;
      }

      .contact-sep {
        display: none;
      }

      /* Stack license card buttons */
      .card-btn-row {
        grid-template-columns: 1fr;
      }

      /* Hide testimonials on mobile */
      .testimonials {
        display: none;
      }
    }
  </style>
</head>
<body>

  <!-- HEADER — nav + verification trust strip pinned together -->
  <header class="site-header">
  <!-- NAV -->
  <nav class="nav" id="nav">
    <div class="nav-inner">
      <a href="#" class="logo">
        <img src="{{ logo_full }}" alt="{{ agency_name }} Logo" class="logo-img" />
      </a>
      <!-- Nav links hidden: these anchors don't link to any section on this page. -->
      <!-- <ul class="nav-links">
        <li><a href="/#about">About</a></li>
        <li><a href="/#services">Services</a></li>
        <li><a href="/#why">Why Us</a></li>
        <li><a href="/#contact" class="nav-cta">Get a Quote</a></li>
      </ul> -->
      <!-- Hamburger hidden: it only opened the mobile menu, which is disabled below. -->
      <!-- <button class="hamburger" id="hamburger" aria-label="Menu">
        <span></span><span></span>
      </button> -->
    </div>
  </nav>

  <!-- VERIFICATION TRUST STRIP -->
  <div class="trust-strip">
    <div class="container trust-strip-inner">
      <div class="trust-items">
        <span class="trust-item"><span class="check" aria-hidden="true">&#10003;</span>Federal background check</span>
        <span class="trust-item"><span class="check" aria-hidden="true">&#10003;</span>FBI fingerprint screening</span>
        <span class="trust-item"><span class="check" aria-hidden="true">&#10003;</span>Licensed life insurance broker</span>
        <span class="trust-item"><span class="check" aria-hidden="true">&#10003;</span>Licensed in every state below</span>
      </div>
      <button type="button" class="trust-seal" id="verifyInfoTrigger"
        aria-haspopup="dialog" aria-expanded="false" aria-controls="verifyInfo">
        <svg class="seal-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2 L20 5 V11 C20 16 16.5 19.5 12 21 C7.5 19.5 4 16 4 11 V5 Z"
            fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-width="1.3"/>
          <path d="M8.4 12 l2.4 2.4 L15.8 9" fill="none" stroke="currentColor"
            stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="seal-text">Verified by VerifyAnAgent</span>
        <span class="seal-cta">&middot; How this works &#9656;</span>
      </button>
    </div>
  </div>
  </header>

  <!-- MOBILE MENU -->
  <!-- <div class="mobile-menu" id="mobileMenu">
    <ul>
      <li><a href="/#about" class="mobile-link">About</a></li>
      <li><a href="/#services" class="mobile-link">Services</a></li>
      <li><a href="/#why" class="mobile-link">Why Us</a></li>
      <li><a href="/#contact" class="mobile-link">Get a Quote</a></li>
    </ul>
  </div> -->

  <!-- HERO -->
  <section class="verify-hero">
    <div class="container">
      <p class="eyebrow">License Verification</p>
      <div class="agent-profile">
        <!-- Drop your photo file (jude-wakim.jpg) into the same folder as this file -->
        <img src="{{ profile_pic }}" alt="{{ agent_name }}" class="agent-photo lightbox-trigger" data-src="{{ profile_pic }}" style="cursor:zoom-in;" />
        <h1 class="verify-name">{{ agent_name }}</h1>
        <span class="agent-badge">Licensed Life Insurance Broker<br>National Producer Number: {{ agent_npn }}{% if agent_npn %}<a href="https://nipr.com/licensing-center/look-up-a-national-producer-number" target="_blank" rel="noopener noreferrer" class="nipr-btn">NIPR&#8202;&#8599;</a>{% endif %}</span>
        <div class="agent-contact">
          <a href="mailto:{{ agent_email }}" class="agent-email">{{ agent_email }}</a>
          {% if calendly_url %}
          <span class="contact-sep">|</span>
          <a href="#"
            onclick="Calendly.initPopupWidget({url:'{{ calendly_url }}'});return false;"
            class="calendly-btn">Schedule a Call</a>
          {% endif %}
        </div>
        <p class="verify-tagline">{{ agent_bio }}</p>

        <!-- Carriers image — click to view full size -->
        {% if carriers_img %}
        <div class="carriers-wrap">
          <span class="carriers-label">Carrier Partners</span>
          <img src="{{ carriers_img }}" alt="Carrier Partners"
              class="carriers-img lightbox-trigger" data-src="{{ carriers_img }}" />
        </div>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- LICENSE CARDS -->
  <section class="licenses section">
    <div class="container">
      <p class="section-label">Active Licenses</p>
      <div class="license-grid">

      {% for state in states %}
      <div class="license-card">
        <div class="license-card-header">
          <img src="/assets/{{ state.seal_filename }}" alt="State of {{ state.name }} Seal"
              class="state-seal" style="background:none; border-radius:0; object-fit:contain;" />
          <div>
            <h2 class="state-name">{{ state.name }}</h2>
            <span class="state-dept">{{ state.dept }}</span>
          </div>
        </div>

        <div class="license-details">
          <div class="license-row">
            {% if state.license_number %}
              <span class="lic-label">License Number</span>
              <span class="lic-value">{{ state.license_number }}</span>
            {% else %}
              <span class="lic-label">National Producer Number</span>
              <span class="lic-value">{{ state.npn or '—' }}</span>
            {% endif %}
          </div>
          <div class="license-row">
            <span class="lic-label">License Type</span>
            <span class="lic-value">Life &amp; Health</span>
          </div>
          <div class="license-row">
            <span class="lic-label">Status</span>
            <span class="lic-value lic-active">Active</span>
          </div>
        </div>

        <div class="card-btn-row{% if hide_certificates %} verify-only{% endif %}">
          {% if not hide_certificates %}
          {% if state.cert_url %}
          <a href="{{ state.cert_url }}" target="_blank" rel="noopener noreferrer"
            class="btn-outline">View Certificate</a>
          {% else %}
          <span class="btn-outline" style="opacity:0.45;cursor:default;">Certificate Pending</span>
          {% endif %}
          {% endif %}

          {% if state.verify_url %}
          <a href="{{ state.verify_url }}" target="_blank" rel="noopener noreferrer"
            class="btn-primary verify-btn">Verify License →</a>
          {% else %}
          <span class="btn-primary verify-btn" style="opacity:0.45;cursor:default;">Verify Online</span>
          {% endif %}
        </div>
      </div>
      {% endfor %}

      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container footer-inner" style="grid-template-columns: 1fr 1fr;">
      <div class="footer-brand">
        <a href="#" class="logo">
          <img src="{{ logo_full }}" alt="{{ agency_name }} Logo" class="logo-img" />
        </a>
        <p>Independent life insurance solutions for families who plan ahead.</p>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <p><a href="mailto:{{ agent_email }}" style="color:rgba(255,255,255,0.5);
          text-decoration:none;">{{ agent_email }}</a></p>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <p>© {{ year }} {{ agency_name }}. All rights reserved. Licensed Life Insurance Agency.
          &nbsp;|&nbsp;
          <a href="https://verifyanagent.com" style="color:inherit;">Powered by verifyanagent.com</a>
        </p>
      </div>
    </div>
  </footer>

  <!-- VERIFICATION INFO MODAL -->
  <div class="info-overlay" id="verifyInfo" role="dialog" aria-modal="true" aria-labelledby="verifyInfoTitle">
    <div class="info-modal">
      <button class="info-close" id="verifyInfoClose" aria-label="Close">&times;</button>
      <h2 id="verifyInfoTitle">How this verification works</h2>
      <div class="info-block">
        <strong>Independent verification</strong>
        <p>VerifyAnAgent independently confirms the identity and active licensing of every agent it publishes &mdash; this page is not self-reported.</p>
      </div>
      <div class="info-block">
        <strong>Identity vetting</strong>
        <p>Before publication, every agent clears a federal criminal background check and FBI fingerprint-based screening.</p>
      </div>
      <div class="info-block">
        <strong>Active licensing, re-checked</strong>
        <p>Licenses are re-verified on a recurring schedule against each state&rsquo;s insurance regulator, so a lapse is reflected on this page.</p>
      </div>
      <div class="info-block">
        <strong>Confirm it yourself</strong>
        <p>Every &ldquo;Verify License&rdquo; button below links to the state regulator&rsquo;s own public lookup, so you can confirm each license independently.</p>
      </div>
      <div class="info-block">
        <strong>Accountability</strong>
        <p>If an agent&rsquo;s license is suspended or revoked, or they are convicted of insurance-related misconduct, this verification page is removed.</p>
      </div>
      <div class="info-block">
        <strong>Misuse is a federal crime</strong>
        <p>Misusing a client&rsquo;s personal or health information carries federal penalties of up to $250,000 in fines and 10 years in prison under HIPAA (42 U.S.C. &sect; 1320d-6); insurance-business fraud carries up to 10&ndash;15 years under 18 U.S.C. &sect; 1033.</p>
      </div>
    </div>
  </div>

  <!-- LIGHTBOX OVERLAY -->
  <div class="lightbox-overlay" id="lightbox">
    <button class="lightbox-close" id="lightboxClose" aria-label="Close">&times;</button>
    <img src="" alt="Full size view" id="lightboxImg" />
  </div>

  <script src="script.js"></script>
  <script>
    // Lightbox for carriers image
    const lightbox    = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightboxImg');

    document.querySelectorAll('.lightbox-trigger').forEach(el => {
      el.addEventListener('click', () => {
        lightboxImg.src = el.dataset.src;
        lightbox.classList.add('open');
      });
    });

    // Close on backdrop click or × button
    lightbox.addEventListener('click', e => {
      if (e.target === lightbox || e.target === document.getElementById('lightboxClose')) {
        lightbox.classList.remove('open');
      }
    });

    // Verification "How this works" modal
    const verifyInfo        = document.getElementById('verifyInfo');
    const verifyInfoTrigger = document.getElementById('verifyInfoTrigger');
    const verifyInfoClose   = document.getElementById('verifyInfoClose');

    verifyInfoTrigger.addEventListener('click', () => {
      verifyInfo.classList.add('open');
      verifyInfoTrigger.setAttribute('aria-expanded', 'true');
    });

    function closeVerifyInfo() {
      verifyInfo.classList.remove('open');
      verifyInfoTrigger.setAttribute('aria-expanded', 'false');
    }

    verifyInfo.addEventListener('click', e => {
      if (e.target === verifyInfo || e.target === verifyInfoClose) closeVerifyInfo();
    });

    // Close on Escape key (shared by the lightbox and the verification modal)
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        lightbox.classList.remove('open');
        closeVerifyInfo();
      }
    });
  </script>

  <!-- TESTIMONIALS CAROUSEL SCRIPT -->
  <script>
    (function () {
      const wrap   = document.querySelector('.testimonials-track-wrap');
      const track  = document.getElementById('tTrack');
      const dotsEl = document.getElementById('tDots');
      if (!track) return;   // no testimonials section rendered — nothing to wire up
      const cards  = track.querySelectorAll('.testimonial-card');
      const total  = cards.length;
      let current  = 0;
      let timer;

      // Set each card's pixel width to match the wrap
      function setCardWidths() {
        const w = wrap.offsetWidth;
        cards.forEach(c => c.style.width = w + 'px');
      }

      // Build dots
      cards.forEach((_, i) => {
        const d = document.createElement('button');
        d.className = 't-dot' + (i === 0 ? ' active' : '');
        d.setAttribute('aria-label', 'Go to testimonial ' + (i + 1));
        d.addEventListener('click', () => goTo(i));
        dotsEl.appendChild(d);
      });

      function goTo(idx) {
        current = (idx + total) % total;
        track.style.transform = 'translateX(-' + (current * wrap.offsetWidth) + 'px)';
        dotsEl.querySelectorAll('.t-dot').forEach((d, i) => {
          d.classList.toggle('active', i === current);
        });
        resetTimer();
      }

      function resetTimer() {
        clearInterval(timer);
        timer = setInterval(() => goTo(current + 1), 6000);
      }

      document.getElementById('tPrev').addEventListener('click', () => goTo(current - 1));
      document.getElementById('tNext').addEventListener('click', () => goTo(current + 1));

      // Pause on hover
      track.addEventListener('mouseenter', () => clearInterval(timer));
      track.addEventListener('mouseleave', resetTimer);

      // Touch/swipe support
      let touchStartX = 0;
      track.addEventListener('touchstart', e => {
        touchStartX = e.touches[0].clientX;
        clearInterval(timer);
      }, { passive: true });
      track.addEventListener('touchend', e => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
        else resetTimer();
      }, { passive: true });

      // Recalculate on resize (e.g. orientation change)
      window.addEventListener('resize', () => {
        setCardWidths();
        goTo(current);
      });

      setCardWidths();
      resetTimer();
    })();
  </script>
</body>
</html>
